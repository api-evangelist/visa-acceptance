  "info": {
    "_postman_id": "a345c34c-4933-41c8-83ab-2a5ab7bf6efd",
    "name": "Visa Acceptance Payments Captures API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Visa Acceptance Payments API (powered by CyberSource) provides REST endpoints for accepting payments online, in-person, and via mobile. The API supports authorization, capture, refund, void, and reversal operations for credit cards, debit cards, digital wallets (Apple Pay, Google Pay), and other payment methods. Authentication uses JSON Web Token (JWT) with RSA key pairs.\n\nContact Support:\n Name: Visa Acceptance Developer Portal",
      "type": "text/plain"
    }
  }
