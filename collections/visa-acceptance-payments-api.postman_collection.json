        {
          "id": "8a65293d-e23e-4121-9314-37477b512f2f",
          "name": "Reverse Authorization",
          "request": {
            "name": "Reverse Authorization",
            "description": {
              "content": "Reverse an authorization to release the held funds back to the customer. An authorization reversal is faster than a void and releases the hold without waiting for settlement.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pts",
                "v2",
                "payments",
                ":paymentId",
                "reversals"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "paymentId",
                  "description": "(Required) The authorization payment ID to reverse"
